# --- Core System and Architecture ---
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_PRINTK=y
CONFIG_TTY=y

# --- Executable Formats and Userspace Support ---
CONFIG_BINFMT_ELF=y
CONFIG_ELFCORE=y

# --- Root Filesystem Support ---
# Required for booting with an initramfs / initrd
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# --- Virtualization and Storage Drivers ---
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# --- Essential Virtual Filesystems ---
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
